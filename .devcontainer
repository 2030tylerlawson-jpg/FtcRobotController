{
  "name": "FTC Java Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "postCreateCommand": "mkdir -p \"$HOME/android-sdk\" && printf 'sdk.dir=%s/android-sdk\\n' \"$HOME\" > local.properties"
}
